        <mxCell id="k64GLVVhW8o_nB6gDJsi-75" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="17 個の離散トークンを各 channel 別の embedding 層で&#xa;4096 次元のベクトルに変換 → [B, 17, 4096, S]。" vertex="1">
          <mxGeometry height="40" width="132.5" x="27.5" y="310" as="geometry" />
        </mxCell>
        <mxCell id="k64GLVVhW8o_nB6gDJsi-76" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="17 ch を要素ごとに足し合わせて [B, 4096, S] へ縮約。&#xa;このベクトルが Temporal Transformer の入力で、&#xa;Main/Other の直前発話と次に何を言うかの情報を内包する。" vertex="1">
          <mxGeometry height="40" width="132.5" x="27.5" y="370" as="geometry" />
        </mxCell>
        <mxCell id="k64GLVVhW8o_nB6gDJsi-81" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="Temporal Transformer (約 7B、Llama 系)&#xa;[B, 4096, S] → [B, 4096, S]&#xa;&quot;何を言うか&quot; だけでなく &quot;どう言うか&quot; の情報も内包。" vertex="1">
          <mxGeometry height="40" width="132.5" x="27.5" y="450" as="geometry" />
        </mxCell>
        <mxCell id="k64GLVVhW8o_nB6gDJsi-82" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="Text head が next text token を生成 (inner monologue)。&#xa;&quot;何を言うか&quot; を 4096-d から抽出する役。&#xa;発話の一貫性向上に寄与。" vertex="1">
          <mxGeometry height="40" width="132.5" x="430" y="510" as="geometry" />
        </mxCell>
        <mxCell id="k64GLVVhW8o_nB6gDJsi-83" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="Depth Transformer (Depformer)&#xa;dim=1024, L=6, multi-linear, per-step weights、dep_q=8&#xa;Temporal 出力 4096-d + 既出 codebook を入力に、&#xa;Main speaker の 8 codebook を 1 step 内で自己回帰生成。&#xa;1 つ目は semantic、以降は音響細部 (粗→細)。" vertex="1">
          <mxGeometry height="105" width="132.5" x="27.5" y="565" as="geometry" />
        </mxCell>
        <mxCell id="k64GLVVhW8o_nB6gDJsi-84" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontSize=8;whiteSpace=wrap;" value="Main speaker audio token (8 cb @ 12.5Hz)&#xa;→ Mimi Decoder で 24kHz wav に復元。" vertex="1">
          <mxGeometry height="40" width="132.5" x="27.5" y="710" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
